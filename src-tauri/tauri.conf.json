{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Text Typer",
  "version": "0.1.0",
  "identifier": "com.alain.texttyper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Text Typer",
        "width": 390,
        "height": 560,
        "minWidth": 330,
        "minHeight": 470,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
